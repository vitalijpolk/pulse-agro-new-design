---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const pages = await getCollection('pages');

  const postPaths = posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { kind: 'post' as const, entry },
  }));
  const pagePaths = pages.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { kind: 'page' as const, entry },
  }));

  return [...postPaths, ...pagePaths];
}

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={'excerpt' in entry.data ? entry.data.excerpt : undefined}>
  {kind === 'post' && 'publishDate' in entry.data && (
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": entry.data.title,
      "description": 'excerpt' in entry.data ? entry.data.excerpt : '',
      "image": 'coverImage' in entry.data && entry.data.coverImage
        ? [`https://pulse-agro.com${entry.data.coverImage}`]
        : [],
      "datePublished": entry.data.publishDate.toISOString(),
      "dateModified": entry.data.publishDate.toISOString(),
      "url": `https://pulse-agro.com/${entry.data.slug}/`,
      "author": { "@type": "Organization", "name": "Pulse Agro", "url": "https://pulse-agro.com" },
      "publisher": {
        "@type": "Organization",
        "name": "Pulse Agro",
        "url": "https://pulse-agro.com",
        "logo": { "@type": "ImageObject", "url": "https://pulse-agro.com/images/site/logo-original.png" }
      }
    })} />
  )}
  <article class="wrap content-page">
    {kind === 'post' && 'coverImage' in entry.data && entry.data.coverImage && (
      <img class="cover" src={entry.data.coverImage} alt={entry.data.title} />
    )}
    <h1>{entry.data.title}</h1>
    {kind === 'post' && 'publishDate' in entry.data && (
      <p class="date">{entry.data.publishDate.toLocaleDateString('uk-UA')}</p>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .content-page { padding: 30px 20px 60px; max-width: 760px; }
  .cover { width: 100%; border-radius: 12px; margin-bottom: 20px; }
  .date { color: #6b6b6b; font-size: 0.9rem; }
  .prose { line-height: 1.7; }
  .prose :global(h2) { margin-top: 2em; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5em 0; }
  .prose :global(th), .prose :global(td) { border: 1px solid #e5e0da; padding: 8px 10px; text-align: left; }
  .prose :global(blockquote) {
    background: #fff8f2;
    border: 1.5px solid #f0c89a;
    border-left: 4px solid #e8772e;
    border-radius: 12px;
    padding: 24px 28px;
    margin: 2em 0;
    color: #1a1a0e;
  }
  .prose :global(blockquote p) { margin: 0 0 10px; }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .prose :global(blockquote strong) { color: #e8772e; font-size: 1.05rem; }
</style>
