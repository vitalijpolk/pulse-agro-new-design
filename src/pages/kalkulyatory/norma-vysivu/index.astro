---
import CalcPage from '../../../components/CalcPage.astro';
import RateCalc from '../../../components/RateCalc.astro';
import NormsTable from '../../../components/NormsTable.astro';
import { cropPages, presets } from '../../../lib/seedRates';
const faq = [
  { q: 'Як розрахувати норму висіву в кг на гектар?', a: 'Норма висіву (кг/га) = кількість насінин на гектар × маса 1000 насінин (г) ÷ 1 000 000. Кількість насінин беруть з урахуванням схожості: бажана густота рослин ÷ (лабораторна схожість × польова схожість).' },
  { q: 'Де взяти масу 1000 насінин?', a: 'Масу 1000 насінин вказують у сертифікаті або на етикетці партії насіння. Вона відрізняється навіть у межах одного гібриду, тому для точного розрахунку беріть значення саме вашої партії.' },
  { q: 'Що таке польова схожість і яку брати?', a: 'Польова схожість — частка насінин, які дали сходи в полі. Вона нижча за лабораторну через холодний ґрунт, кірку, шкідників і глибину загортання. Орієнтовно: кукурудза 85–95%, соняшник 80–90%, зернові 70–85%.' },
];
---

<CalcPage
  title="Калькулятор норми висіву в кг/га — кукурудза, соняшник, соя, пшениця"
  description="Розрахуйте норму висіву в кг на гектар за масою 1000 насінин, схожістю і бажаною густотою. Також — кількість насінин на погонний метр рядка."
  h1="Калькулятор норми висіву: кг на гектар і насінин на метр"
  path="/kalkulyatory/norma-vysivu/"
  crumb="Норма висіву, кг/га"
  intro="Вкажіть бажану густоту рослин, масу 1000 насінин і схожість — калькулятор порахує, скільки насінин висівати на гектар, норму в кілограмах і скільки насінин класти на погонний метр рядка для налаштування сівалки."
  faq={faq}
  leadTopic="nasinnya"
  links={[
    { href: '/norma-vysivu-kukurudzy/', label: 'Норма висіву кукурудзи' },
    { href: '/norma-vysivu-sonyashnyka/', label: 'Норма висіву соняшнику' },
    { href: '/norma-vysivu-soyi/', label: 'Норма висіву сої' },
    { href: '/kalkulyatory/nasinnya/', label: 'Калькулятор посівних одиниць на площу' },
    { href: '/kalkulyatory/nalashtuvannya-sivalky/', label: 'Калькулятор встановлення сівалки на норму висіву' },
  ]}
>
  <RateCalc crop="corn" />
  <div class="crop-chips" role="navigation" aria-label="Калькулятор норми висіву для культури">
    {Object.entries(cropPages).map(([slug, c]) => <a href={`/kalkulyatory/norma-vysivu/${slug}/`}>{presets[c.crop].label}</a>)}
  </div>

  <section class="how" slot="how">
    <h2>Як рахує калькулятор</h2>
    <ol>
      <li>Посівна придатність = лабораторна схожість × чистота насіння.</li>
      <li>Кількість насінин на 1 га = бажана густота ÷ (посівна придатність × польова схожість).</li>
      <li>Норма висіву, кг/га = кількість насінин × маса 1000 насінин (г) ÷ 1 000 000.</li>
      <li>Насінин на метр рядка = кількість насінин на 1 га × ширина міжряддя (м) ÷ 10 000.</li>
    </ol>
    <p>Приклад для кукурудзи: густота 70 тис./га, маса 1000 насінин 280 г, схожість 95%, чистота 99%, польова схожість 90% → 70 000 ÷ (0,95 × 0,99 × 0,9) ≈ 82 700 насінин/га → <b>23,2 кг/га</b>, приблизно 5,8 насінини на метр рядка при міжрядді 70 см.</p>

    <NormsTable />
  </section>
</CalcPage>

<style>
  .crop-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; }
  .crop-chips a { padding: 6px 12px; border-radius: 999px; background: #f7f4ef; color: #bc5615; font-weight: 600; font-size: 0.88rem; }
  .crop-chips a:hover { background: #fff1e6; }
</style>
