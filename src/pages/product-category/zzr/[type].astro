---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryListing from '../../../components/CategoryListing.astro';

export function getStaticPaths() {
  const types = {
    herbicides: 'Гербіциди',
    fungicides: 'Фунгіциди',
    insecticides: 'Інсектициди',
    pesticides: 'Протруйники',
    desiccants: 'Дисиканти',
  };
  return Object.entries(types).map(([slug, label]) => ({ params: { type: slug }, props: { label } }));
}

const { type } = Astro.params;
const { label } = Astro.props;
---
<BaseLayout title={label} description={`Засоби захисту рослин: ${label}. Каталог Pulse Agro.`}>
  <CategoryListing categoryGroup="zzr" category={type} title={label} />
</BaseLayout>
