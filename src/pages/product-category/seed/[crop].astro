---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryListing from '../../../components/CategoryListing.astro';

type CropMeta = {
  label: string;
  title: string;
  description: string;
  h1: string;
  seoText: string;
};

export function getStaticPaths() {
  const cropMeta: Record<string, CropMeta> = {
  sunflower: {
    label: 'Соняшник',
    title: 'Насіння соняшнику купити в Україні — гібриди, ціни',
    description: 'Насіння гібридів соняшнику від українських виробників. Гібриди під Євро-Лайтнінг, Гранстар, Clearfield. Підбір під регіон. Доставка по Україні.',
    h1: 'Насіння соняшнику — гібриди для України',
    seoText: `Pulse Agro реалізує насіння гібридів соняшнику від перевірених вітчизняних виробників. У каталозі представлені гібриди під різні технології вирощування: класичну, Євро-Лайтнінг Плюс, Гранстар та Clearfield. Кожен гібрид підібраний з урахуванням умов вирощування в українських регіонах — Степу, Лісостепу та Полісся.

Ми допомагаємо обрати гібрид під конкретний ґрунт і кліматичні умови господарства. Наші агрономи нададуть консультацію щодо норми висіву, схеми захисту рослин та технології вирощування. Насіння надходить безпосередньо від виробника, повністю відкалібровано та протруєно — готове до сівби.

Купити насіння соняшнику оптом або в роздріб з доставкою по всій Україні. Зв'яжіться з нами за телефоном або залиште заявку на сайті — відповімо протягом робочого дня.`,
  },
  corn: {
    label: 'Кукурудза',
    title: 'Насіння кукурудзи купити в Україні — гібриди ФАО, ціни',
    description: 'Насіння гібридів кукурудзи ФАО 180–350. Вітчизняна та іноземна селекція. Купити оптом і в роздріб з доставкою по Україні. Консультація агронома.',
    h1: 'Насіння кукурудзи — гібриди ФАО 180–350',
    seoText: `Pulse Agro пропонує насіння гібридів кукурудзи різних груп стиглості — від ранніх ФАО 180 до пізніх ФАО 350. У каталозі є гібриди вітчизняної селекції (ДН Хотин, Ангора, Самарія, Сігірія) та зарубіжні аналоги, підібрані для вирощування в умовах України.

При виборі гібриду враховуємо зону вирощування: для Степу підходять посухостійкі гібриди з низькою збиральною вологістю, для Лісостепу — гібриди з вищим потенціалом урожайності та хорошою стійкістю до хвороб. Надаємо рекомендації щодо густоти посіву, строків сівби та схеми захисту.

Купити насіння кукурудзи оптом або одну посівну одиницю з доставкою по всій Україні. Насіння відкаліброване та протруєне, повністю готове до сівби. Телефонуйте або залишайте заявку — підберемо оптимальний гібрид під ваше господарство.`,
  },
  wheat: {
    label: 'Пшениця',
    title: 'Насіння озимої пшениці купити в Україні — сорти, ціни',
    description: 'Сорти озимої пшениці вітчизняної селекції. Елітне та репродукційне насіння з доставкою по Україні. Підбір сорту під регіон і умови господарства.',
    h1: 'Насіння озимої пшениці — сорти для Степу і Лісостепу',
    seoText: `Pulse Agro реалізує насіння сортів озимої пшениці вітчизняної селекції, внесених до Реєстру сортів рослин України. У каталозі представлені сорти для різних зон вирощування: посухостійкі для Степу, високоврожайні для Лісостепу та зимостійкі для Полісся.

Ми допомагаємо підібрати сорт з урахуванням попередника, типу ґрунту та умов конкретного регіону. Надаємо рекомендації щодо строків сівби, норми висіву та захисту посівів від хвороб і шкідників. Насіння поставляється кондиційним — з паспортом якості від виробника.

Купити насіння озимої пшениці оптом або в роздріб з доставкою по всій Україні. Зв'яжіться з нами для консультації та оформлення замовлення.`,
  },
  rapeseed: {
    label: 'Рапс',
    title: 'Насіння рапсу купити в Україні — озимий і ярий рапс, ціни',
    description: 'Насіння озимого та ярого рапсу від перевірених виробників. Гібриди під різні технології вирощування. Доставка по Україні. Консультація агронома.',
    h1: 'Насіння рапсу — озимий і ярий рапс для України',
    seoText: `Pulse Agro пропонує насіння гібридів рапсу для вирощування в умовах України. У каталозі представлені гібриди озимого та ярого рапсу з високим потенціалом врожайності та вмістом олії, стійкі до полягання та основних хвороб.

Підбираємо гібрид з урахуванням технології вирощування господарства, зони та попередника. Надаємо рекомендації щодо строків сівби, норми висіву, схеми живлення та захисту. Насіння постачається безпосередньо від виробника — відкалібровано, протруєно та готове до сівби.

Купити насіння рапсу оптом або в роздріб з доставкою по всій Україні. Телефонуйте або залишайте заявку на сайті.`,
  },
  barley: {
    label: 'Ячмінь',
    title: 'Насіння ячменю купити в Україні — ярий і озимий ячмінь, ціни',
    description: 'Сорти ярого та озимого ячменю з підтвердженою врожайністю. Насіння для Степу, Лісостепу та Полісся. Доставка по Україні.',
    h1: 'Насіння ячменю — ярий і озимий ячмінь',
    seoText: `Pulse Agro реалізує насіння сортів ярого та озимого ячменю вітчизняної селекції. У каталозі представлені сорти з підтвердженою врожайністю в умовах Степу, Лісостепу та Полісся, стійкі до посухи, хвороб і полягання.

Ячмінь є важливою зерновою культурою в Україні — підходить як для товарного виробництва зерна, так і для кормових цілей. Ми допомагаємо обрати сорт з урахуванням попередника, ґрунтових умов і мети вирощування. Надаємо рекомендації щодо агротехніки та захисту посівів.

Купити насіння ячменю оптом або в роздріб з доставкою по всій Україні. Залиште заявку або зателефонуйте — підберемо оптимальний сорт для вашого господарства.`,
  },
  pea: {
    label: 'Горох',
    title: 'Насіння гороху купити в Україні — сорти, ціни',
    description: 'Сорти гороху з високим потенціалом врожайності. Насіння вітчизняної та іноземної селекції. Доставка по Україні. Консультація агронома.',
    h1: 'Насіння гороху — сорти для України',
    seoText: `Pulse Agro пропонує насіння сортів гороху для вирощування в умовах України. Горох — цінна бобова культура, яка покращує родючість ґрунту та є ефективним попередником для озимої пшениці та інших зернових.

У каталозі представлені сорти вітчизняної та іноземної селекції з різними строками дозрівання — від ранніх до середньопізніх. Ми підбираємо сорт з урахуванням умов господарства, надаємо рекомендації щодо норми висіву та захисту рослин від хвороб і бур'янів.

Купити насіння гороху оптом або в роздріб з доставкою по всій Україні. Зв'яжіться з нами для консультації та оформлення замовлення.`,
  },
  soy: {
    label: 'Соя',
    title: 'Насіння сої купити в Україні — сорти, ціни',
    description: 'Сорти сої під Roundup Ready та класичну технологію. Насіння з підтвердженою врожайністю. Доставка по Україні. Консультація агронома.',
    h1: 'Насіння сої — сорти під різні технології',
    seoText: `Pulse Agro реалізує насіння сортів сої для вирощування в Україні. У каталозі представлені сорти під класичну технологію вирощування та технологію Roundup Ready, адаптовані до кліматичних умов різних регіонів.

Соя є однією з найрентабельніших культур в Україні завдяки стабільному попиту на внутрішньому та зовнішньому ринках. Ми допомагаємо обрати сорт з урахуванням зони вирощування, попередника та доступної техніки. Надаємо рекомендації щодо інокуляції насіння, норми висіву та захисту посівів.

Купити насіння сої оптом або в роздріб з доставкою по всій Україні. Телефонуйте або залишайте заявку — підберемо оптимальний сорт для вашого господарства.`,
  },
};

  return Object.entries(cropMeta).map(([slug, data]) => ({
    params: { crop: slug },
    props: { meta: data },
  }));
}

const { crop } = Astro.params;
const { meta } = Astro.props;
---
<BaseLayout title={meta.title} description={meta.description}>
  <CategoryListing categoryGroup="seed" category={crop} title={meta.h1} />
  <div class="seo-block wrap">
    <p set:html={meta.seoText.replace(/\n\n/g, '</p><p>')}></p>
  </div>
</BaseLayout>

<style>
  .seo-block {
    padding: 0 20px 60px;
    max-width: 860px;
  }
  .seo-block p {
    color: #5a5a5a;
    line-height: 1.75;
    margin: 0 0 14px;
    font-size: 0.95rem;
  }
</style>
