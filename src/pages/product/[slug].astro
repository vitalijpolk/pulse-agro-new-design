---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import OrderForm from '../../components/OrderForm.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { product: p.data } }));
}

const { product } = Astro.props;
const allProducts = await getCollection('products');

const manufacturerEntry =
  product.manufacturer === 'unknown' ? undefined : await getEntry('manufacturers', product.manufacturer);
const technologyEntry = product.technology ? await getEntry('technologies', product.technology) : undefined;

const related = product.relatedProducts
  .map((slug) => allProducts.find((p) => p.data.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const minPrice = Math.min(...product.priceTiers.map((t) => t.price));
const priceValidUntil = new Date(new Date().setFullYear(new Date().getFullYear() + 1)).toISOString().split('T')[0];

const priceLabel = minPrice > 0 ? `${minPrice} грн` : 'за запитом';
const seoTitle = `Купити ${product.title} — ціна ${priceLabel}`;
const seoDescription = `Купити ${product.title} в Pulse Agro. Ціна ${priceLabel}${product.tagline ? '. ' + product.tagline : ''}. Доставка по Україні, консультація агронома.`.slice(0, 160);

function parseScore(value: string): number | null {
  const m = value.trim().match(/^(\d{1,2})(?:\s*\/\s*10)?$/);
  if (!m) return null;
  const n = Number(m[1]);
  return n >= 1 && n <= 10 ? n : null;
}
---
<BaseLayout title={seoTitle} description={seoDescription}>
  {minPrice > 0 && (
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": `https://pulse-agro.com/product/${product.slug}/`,
      "url": `https://pulse-agro.com/product/${product.slug}/`,
      "name": product.title,
      "description": product.description || product.tagline || product.title,
      "image": product.images.length > 0
        ? product.images.map(img => `https://pulse-agro.com${img}`)
        : undefined,
      "sku": product.sku || product.slug,
      "brand": {
        "@type": "Brand",
        "name": manufacturerEntry?.data.name ?? "Pulse Agro"
      },
      "offers": product.priceTiers.length === 1
        ? {
            "@type": "Offer",
            "priceCurrency": "UAH",
            "price": product.priceTiers[0].price,
            "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
            "itemCondition": "https://schema.org/NewCondition",
            "priceValidUntil": priceValidUntil,
            "url": `https://pulse-agro.com/product/${product.slug}/`,
            "seller": { "@type": "Organization", "name": "Pulse Agro", "url": "https://pulse-agro.com" }
          }
        : {
            "@type": "AggregateOffer",
            "priceCurrency": "UAH",
            "lowPrice": minPrice,
            "highPrice": Math.max(...product.priceTiers.map(t => t.price)),
            "offerCount": product.priceTiers.filter(t => t.price > 0).length,
            "priceValidUntil": priceValidUntil,
            "offers": product.priceTiers.filter(t => t.price > 0).map(t => ({
              "@type": "Offer",
              "name": t.label,
              "priceCurrency": "UAH",
              "price": t.price,
              "priceValidUntil": priceValidUntil,
              "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
              "itemCondition": "https://schema.org/NewCondition",
              "url": `https://pulse-agro.com/product/${product.slug}/`,
              "seller": { "@type": "Organization", "name": "Pulse Agro", "url": "https://pulse-agro.com" }
            }))
          }
    })} />
  )}
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Головна", "item": "https://pulse-agro.com/" },
      { "@type": "ListItem", "position": 2, "name": "Насіння", "item": "https://pulse-agro.com/product-category/seed/" },
      { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://pulse-agro.com/product/${product.slug}/` }
    ]
  })} />
  <div class="wrap product-page">
    <nav class="breadcrumb">
      <a href="/">Головна</a> /
      <a href={`/product-category/${product.categoryGroup}/${product.category}/`}>{product.category}</a> /
      {product.title}
    </nav>

    <div class="product-top">
      <div class="gallery">
        {product.images.length > 0 ? product.images.map((img) => (
          <div class="gallery-frame">
            <img src={img} alt={product.title} />
          </div>
        )) : (
          <div class="gallery-frame gallery-placeholder">
            <span>Фото незабаром</span>
          </div>
        )}
      </div>

      <div class="summary">
        <h1>{product.title}</h1>

        <p class="meta-line">
          {product.sku && <span>Артикул: <strong>{product.sku}</strong></span>}
          {manufacturerEntry && <span>Виробник: <strong>{manufacturerEntry.data.name}</strong></span>}
          {technologyEntry && <span>Технологія: <strong>{technologyEntry.data.name}</strong></span>}
        </p>

        <p class="price">
          {product.priceTiers.length > 1
            ? `від ${minPrice} грн`
            : minPrice > 0 ? `${minPrice} грн` : 'Ціна за запитом'}
        </p>

        {product.priceTiers.length > 1 && (
          <ul class="tiers">
            {product.priceTiers.map((t) => (
              <li>{t.label}: <strong>{t.price} грн</strong></li>
            ))}
          </ul>
        )}

        <p class="description">{product.description}</p>
      </div>

      <div class="order-column">
        <OrderForm slug={product.slug} title={product.title} priceTiers={product.priceTiers} />
      </div>
    </div>

    {product.specs.length > 0 && (
      <section class="specs">
        {product.specs.map((section) => (
          <div class="spec-group">
            <h2>{section.title}</h2>
            <table>
              <tbody>
                {section.items.map((item) => {
                  const score = parseScore(item.value);
                  return (
                    <tr>
                      <th>{item.label}</th>
                      <td>
                        {score !== null ? (
                          <span class="score">
                            <span class="score-track"><span class="score-fill" style={`width:${score * 10}%`} /></span>
                            <span class="score-num">{score}</span>
                          </span>
                        ) : item.value}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ))}
      </section>
    )}

    {product.growingTips.length > 0 && (
      <section class="growing-tips">
        <h2 class="block-title">Практичні рекомендації з вирощування</h2>
        <div class="tips-grid">
          {product.growingTips.map((tip, i) => (
            <div class="tip-card">
              <span class="tip-num">0{i + 1}</span>
              <h3>{tip.title}</h3>
              <p>{tip.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="why-us">
      <div class="why-header">
        <h2>Чому купують насіння у Pulse Agro</h2>
        <p>Працюємо напряму з виробниками — без посередників, без підробок</p>
      </div>
      <ul class="why-list">
        <li>
          <svg class="why-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="#e8772e" fill-opacity="0.12"/>
            <path d="M13 20.5l5 5 9-10" stroke="#e8772e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong>Оригінальне насіння від виробника</strong>
            <span>Офіційне походження, сертифікати якості, відсутність підробок.</span>
          </div>
        </li>
        <li>
          <svg class="why-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="#e8772e" fill-opacity="0.12"/>
            <path d="M13 20.5l5 5 9-10" stroke="#e8772e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong>Опт і роздріб</strong>
            <span>Зручні партії для фермерів, господарств і великих агропідприємств.</span>
          </div>
        </li>
        <li>
          <svg class="why-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="#e8772e" fill-opacity="0.12"/>
            <path d="M13 20.5l5 5 9-10" stroke="#e8772e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong>Доставка по всій Україні</strong>
            <span>Відправлення у зручний для вас спосіб — самовивіз або кур'єр.</span>
          </div>
        </li>
        <li>
          <svg class="why-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="#e8772e" fill-opacity="0.12"/>
            <path d="M13 20.5l5 5 9-10" stroke="#e8772e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong>Безкоштовна консультація агронома</strong>
            <span>Підбір густоти посіву, системи живлення та захисту під ваш гібрид і регіон.</span>
          </div>
        </li>
        <li>
          <svg class="why-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="#e8772e" fill-opacity="0.12"/>
            <path d="M13 20.5l5 5 9-10" stroke="#e8772e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong>Гнучкі умови оплати</strong>
            <span>Готівка, безготівкова, передоплата або відстрочення для постійних клієнтів.</span>
          </div>
        </li>
      </ul>
    </section>

    {related.length > 0 && (
      <section class="related">
        <h2>Супутні товари</h2>
        <div class="grid">
          {related.map((p) => (
            <ProductCard
              slug={p.data.slug}
              title={p.data.title}
              image={p.data.images[0]}
              minPrice={Math.min(...p.data.priceTiers.map((t) => t.price))}
              tagline={p.data.tagline}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .product-page { padding: 30px 20px 60px; }
  .breadcrumb { font-size: 0.85rem; color: #6b6b6b; margin-bottom: 20px; text-transform: capitalize; }
  .product-top { display: grid; grid-template-columns: minmax(260px, 380px) 1fr minmax(280px, 340px); gap: 32px; align-items: start; }
  .gallery-frame {
    aspect-ratio: 1 / 1; background: #f6f4f0; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; padding: 28px; margin-bottom: 12px;
  }
  .gallery-frame img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; display: block; }
  .gallery-placeholder { border: 1.5px dashed #d9d2c4; }
  .gallery-placeholder span { color: #a39c8c; font-size: 0.88rem; text-align: center; }
  h1 { margin-top: 0; }
  .meta-line { display: flex; flex-wrap: wrap; gap: 6px 18px; color: #6b6b6b; font-size: 0.88rem; margin: 10px 0 16px; }
  .meta-line strong { color: #1a1a1a; }
  .price { font-size: 1.6rem; font-weight: 800; color: #e8772e; margin: 10px 0; }
  .tiers { list-style: none; padding: 0; margin: 0 0 18px; display: flex; gap: 16px; flex-wrap: wrap; }
  .tiers li { background: #f7f4ef; padding: 8px 14px; border-radius: 8px; font-size: 0.9rem; }
  .description { color: #444; line-height: 1.6; margin-bottom: 24px; }
  .order-column { position: sticky; top: 20px; }

  .specs { margin-top: 50px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .spec-group { background: #fff; border: 1px solid #e8e2d8; border-radius: 14px; padding: 22px 24px 6px; }
  .spec-group h2 {
    font-size: 0.8rem; font-weight: 800; letter-spacing: 0.03em; color: #1a1a1a;
    border-bottom: 2px solid #e8772e; display: inline-block; padding-bottom: 6px; margin: 0 0 14px;
  }
  .spec-group table { width: 100%; border-collapse: collapse; font-size: 0.94rem; }
  .spec-group tr { border-bottom: 1px solid #ece7de; }
  .spec-group tr:last-child { border-bottom: none; }
  .spec-group th, .spec-group td { padding: 12px 0; vertical-align: middle; font-weight: 400; }
  .spec-group th { text-align: left; color: #6b6b6b; padding-right: 16px; }
  .spec-group td { text-align: right; color: #1a1a1a; font-weight: 700; }

  .score { display: inline-flex; align-items: center; gap: 8px; }
  .score-track { width: 56px; height: 6px; border-radius: 3px; background: #ece7de; overflow: hidden; flex-shrink: 0; }
  .score-fill { display: block; height: 100%; background: #e8772e; border-radius: 3px; }
  .score-num { font-variant-numeric: tabular-nums; min-width: 1.1em; text-align: right; }

  .block-title { font-size: 1.15rem; font-weight: 700; margin: 0 0 20px; color: #1a1a1a; }

  .growing-tips { margin-top: 56px; }
  .tips-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid #e8e2d8;
    border-radius: 16px;
    overflow: hidden;
  }
  .tip-card {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-right: 1px solid #e8e2d8;
    background: #fff;
  }
  .tip-card:last-child { border-right: none; }
  .tip-num { font-size: 0.72rem; font-weight: 800; color: #e8772e; letter-spacing: 0.06em; }
  .tip-card h3 { font-size: 0.9rem; font-weight: 700; margin: 0; color: #1a1a1a; line-height: 1.3; }
  .tip-card p { font-size: 0.82rem; color: #5a5a5a; line-height: 1.7; margin: 0; }

  .why-us { margin-top: 56px; background: #111109; border-radius: 20px; padding: 40px 44px; }
  .why-header { margin-bottom: 28px; }
  .why-header h2 { font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0 0 6px; }
  .why-header p { font-size: 0.88rem; color: rgba(255,255,255,0.45); margin: 0; }
  .why-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .why-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .why-list li:nth-last-child(-n+2) { border-bottom: none; }
  .why-list li:nth-child(odd) { padding-right: 32px; border-right: 1px solid rgba(255,255,255,0.07); }
  .why-list li:nth-child(even) { padding-left: 32px; }
  .why-list li:last-child:nth-child(odd) { border-right: none; }
  .why-icon { width: 36px; height: 36px; flex-shrink: 0; margin-top: 1px; }
  .why-list strong { display: block; font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
  .why-list span { font-size: 0.83rem; color: rgba(255,255,255,0.5); line-height: 1.55; }

  .related { margin-top: 60px; }
  .related .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; margin-top: 16px; align-items: start; }

  @media (max-width: 1100px) {
    .tips-grid { grid-template-columns: repeat(3, 1fr); }
    .tip-card:nth-child(3) { border-right: none; }
    .tip-card:nth-child(4) { border-top: 1px solid #e8e2d8; }
    .tip-card:nth-child(5) { border-top: 1px solid #e8e2d8; border-right: none; }
  }

  @media (max-width: 1000px) {
    .product-top { grid-template-columns: 1fr 1fr; }
    .order-column { grid-column: 1 / -1; position: static; }
    .why-us { padding: 28px 24px; }
  }

  @media (max-width: 700px) {
    .product-top { grid-template-columns: 1fr; }
    .tips-grid { grid-template-columns: 1fr 1fr; }
    .tip-card { border-right: none !important; border-top: 1px solid #e8e2d8; }
    .tip-card:first-child { border-top: none; }
    .why-list { grid-template-columns: 1fr; }
    .why-list li:nth-child(odd) { padding-right: 0; border-right: none; }
    .why-list li:nth-child(even) { padding-left: 0; }
    .why-list li:nth-last-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.07); }
    .why-list li:last-child { border-bottom: none; }
    .why-us { padding: 24px 20px; border-radius: 14px; }
  }
</style>
