---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Про компанію — постачальник насіння агрокультур" description="Pulse Agro — реалізація якісного насіння гібридів соняшнику, кукурудзи, пшениці, рапсу та інших агрокультур. Підбір гібридів, консультації, технологічний супровід.">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Головна", "item": "https://pulse-agro.com/" },
      { "@type": "ListItem", "position": 2, "name": "Про компанію", "item": "https://pulse-agro.com/about-company/" }
    ]
  })} />
  <div class="about-page">

    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-content">
        <nav class="breadcrumb"><a href="/">Головна</a> / <span>Про компанію</span></nav>
        <div class="hero-body">
          <div class="hero-logo">
            <img src="/images/site/logo-original.png" alt="Pulse Agro" />
          </div>
          <div class="hero-text">
            <h1>Якісне насіння для стабільного врожаю</h1>
            <p class="lead">
              Pulse Agro постачає сертифіковане насіння від перевірених українських виробників, яке вже
              демонструє стабільні результати на полях по всій Україні. Допомагаємо підібрати оптимальні
              гібриди під ваші умови вирощування, щоб отримати максимальний урожай.
            </p>
            <a class="btn-primary" href="/product-category/seed/">Переглянути каталог →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="wrap services-section">
      <h2 class="section-title">Що ми пропонуємо</h2>
      <div class="services-grid">

        <div class="service-card">
          <span class="snum">01</span>
          <h3>Підбір гібридів</h3>
          <p>Підберемо насіння під ґрунтові та кліматичні особливості вашого регіону і розрахуємо оптимальну норму висіву.</p>
        </div>

        <div class="service-card">
          <span class="snum">02</span>
          <h3>Технологічний супровід</h3>
          <p>Консультуємо з питань вирощування від підготовки ґрунту до збирання врожаю — для кожної культури з каталогу.</p>
        </div>

        <div class="service-card">
          <span class="snum">03</span>
          <h3>Засоби захисту і добрива</h3>
          <p>Допомагаємо підібрати засоби захисту рослин та добрива під конкретний гібрид і умови вирощування.</p>
        </div>

      </div>
    </section>

    <!-- MEDIA GALLERY -->
    <section class="wrap media-section">
      <h2 class="section-title">З перших рук</h2>
      <div class="media-grid">
        <img src="/images/about/bags-stack.webp" alt="Насіння Pulse Agro" loading="lazy" />
        <video src="/video/about-clip.mp4" poster="/images/about/clip-poster.jpg" autoplay loop muted playsinline></video>
        <video src="/video/about-clip2.mp4" poster="/images/about/clip2-poster.jpg" autoplay loop muted playsinline></video>
        <img src="/images/about/team-van.webp" alt="Команда Pulse Agro" loading="lazy" />
      </div>
    </section>

    <!-- CTA -->
    <div class="wrap">
      <div class="cta-block">
        <div>
          <p class="cta-title">Готові обговорити ваш урожай?</p>
          <p class="cta-sub">Зателефонуйте або напишіть — підберемо насіння під ваш регіон і бюджет.</p>
        </div>
        <div class="cta-buttons">
          <a class="btn-primary" href="/product-category/seed/">Каталог насіння</a>
          <a class="btn-secondary" href="/contacts/">Зв'язатись</a>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .about-page { padding-bottom: 70px; }

  .breadcrumb { font-size: 0.85rem; color: rgba(255,255,255,0.45); margin-bottom: 32px; }
  .breadcrumb a { color: rgba(255,255,255,0.55); }
  .breadcrumb a:hover { color: #fff; }

  /* HERO */
  .hero {
    background: #111109;
    display: flex; align-items: center; color: #fff;
  }
  .hero-content { padding: 64px 20px 72px; }
  .hero-body {
    display: flex; align-items: center; gap: 48px;
  }
  .hero-logo { flex-shrink: 0; }
  .hero-logo img { height: 100px; width: auto; display: block; }
  .hero-text { flex: 1; }
  h1 { font-size: 2.2rem; margin: 0 0 18px; line-height: 1.2; }
  .lead { color: rgba(255,255,255,0.7); line-height: 1.7; margin: 0 0 32px; font-size: 1rem; max-width: 520px; }

  .btn-primary {
    display: inline-block; background: #e8772e; color: #fff; font-weight: 700;
    border-radius: 999px; padding: 13px 28px; transition: background 0.15s;
  }
  .btn-primary:hover { background: #d9691f; }

  /* SERVICES */
  .services-section { padding: 60px 20px 0; }
  .section-title {
    font-size: 1.5rem; font-weight: 800; border-bottom: 2px solid #e8772e;
    display: inline-block; padding-bottom: 6px; margin: 0 0 28px;
  }
  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: #e8e2d8; border-radius: 16px; overflow: hidden;
  }
  .service-card { background: #fff; padding: 32px 28px; }
  .snum {
    display: block; font-size: 0.72rem; font-weight: 800; color: #bc5615;
    letter-spacing: 0.08em; margin-bottom: 14px;
  }
  .service-card h3 { font-size: 1rem; font-weight: 700; margin: 0 0 10px; color: #1a1a1a; }
  .service-card p { color: #5a5a5a; font-size: 0.88rem; line-height: 1.65; margin: 0; }

  /* MEDIA */
  .media-section { padding: 60px 20px 0; }
  .media-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .media-grid img, .media-grid video {
    width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 12px; display: block;
    box-shadow: 0 4px 16px rgba(28,26,20,0.1);
  }

  /* CTA */
  .cta-block {
    margin: 60px 20px 0; background: linear-gradient(135deg, #1c1c1c 0%, #2e2a24 100%);
    border-radius: 18px; padding: 36px 40px; display: flex;
    align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  }
  .cta-title { color: #fff; font-size: 1.15rem; font-weight: 700; margin: 0 0 6px; }
  .cta-sub { color: #a09890; font-size: 0.9rem; margin: 0; }
  .cta-buttons { display: flex; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
  .btn-secondary {
    background: rgba(255,255,255,0.1); color: #fff; font-weight: 600; border-radius: 999px;
    padding: 13px 28px; border: 1px solid rgba(255,255,255,0.2); transition: background 0.15s;
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.18); color: #fff; }

  @media (max-width: 900px) {
    .hero-content { padding: 48px 20px 56px; }
    .hero-body { gap: 32px; }
    .hero-logo img { height: 80px; }
    h1 { font-size: 1.7rem; }
    .services-grid { grid-template-columns: 1fr; border-radius: 12px; }
    .cta-block { align-items: center; text-align: center; }
    .cta-buttons { justify-content: center; width: 100%; }
    .media-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-block { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
  }

  @media (max-width: 600px) {
    .hero-content { padding: 40px 20px 48px; }
    .hero-body { flex-direction: column; align-items: flex-start; gap: 24px; }
    .hero-logo img { height: 72px; }
    .media-grid { gap: 10px; }
    h1 { font-size: 1.6rem; }
  }
</style>
